# Example environment configuration for the AI Refund Support Agent.
# Copy to `.env` and adjust as needed. All variables are optional; sensible
# defaults are baked in. Every variable is prefixed with REFUND_AGENT_.

# --- General ---
REFUND_AGENT_APP_NAME="ShopSphere Refund Agent"
REFUND_AGENT_ENVIRONMENT=development
REFUND_AGENT_LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR | CRITICAL

# --- LLM provider selection ---
# auto      : use local Ollama if reachable, else the deterministic heuristic planner
# ollama    : require a local Ollama server (open-source models, no API key)
# heuristic : always use the dependency-free deterministic planner
REFUND_AGENT_LLM_PROVIDER=auto

# --- Ollama (only used when provider is `auto` or `ollama`) ---
REFUND_AGENT_OLLAMA_HOST=http://localhost:11434
REFUND_AGENT_OLLAMA_MODEL=llama3.1
REFUND_AGENT_OLLAMA_TIMEOUT_SECONDS=60

# --- Agent loop ---
REFUND_AGENT_AGENT_MAX_ITERATIONS=8
